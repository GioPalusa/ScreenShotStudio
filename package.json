{
  "name": "screenshot-studio",
  "private": true,
  "type": "module",
  "description": "Offline Mac app for composing multilingual store screenshots and marketing graphics.",
  "scripts": {
    "start": "node studio.mjs",
    "export": "node studio.mjs export",
    "test": "node tools/check.mjs",
    "desktop": "node node_modules/electron/cli.js .",
    "package": "node tools/package.mjs",
    "test:render": "node tools/render-test.mjs",
    "mcp": "node tools/mcp/server.mjs",
    "test:mcp": "node --test tools/mcp.test.mjs",
    "release:zip": "node tools/release-zip.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.0"
  },
  "version": "0.2.8",
  "productName": "Screenshot Studio",
  "main": "desktop/entry.mjs",
  "license": "MIT",
  "author": "Giovanni Palusa",
  "repository": {
    "type": "git",
    "url": "https://github.com/GioPalusa/ScreenShotStudio.git"
  },
  "homepage": "https://github.com/GioPalusa/ScreenShotStudio",
  "bugs": {
    "url": "https://github.com/GioPalusa/ScreenShotStudio/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  }
}
